# Salin file ini menjadi .env, lalu isi dengan nilai asli Anda.
# JANGAN pernah commit file .env ke GitHub.

# Connection string dari dashboard Neon Anda
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret key untuk JWT (bebas, buat string acak yang panjang)
JWT_SECRET=ganti_dengan_string_rahasia_yang_panjang_dan_acak

# Dari dashboard Cloudinary Anda
CLOUDINARY_CLOUD_NAME=lu5s9cnu
CLOUDINARY_UPLOAD_PRESET=capsee_scans

PORT=8000
